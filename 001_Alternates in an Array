You are given an array arr[], the task is to return a list elements of arr in alternate order (starting from index 0).

Input: arr[] = [1, 2, 3, 4]
Output: 1 3


class Solution:
    def getAlternates(self, arr):
        # Code Here
        res = []
        for i in range(0,len(arr),2):
            res.append(arr[i])
        return res
